# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv-*/
*.bak

# Generated benchmark scripts (rebuilt deterministically by scripts/make_rerun_*.py)
path2_winning_v2.py
path2_conformal_v3.py
path2_tau_schedule.py

# Regenerable datasets (the benchmark and calibration sets below are SHIPPED)
capture_lib_v2/calibration_regen_200.npz
capture_lib_v2/ood_fast_45.npz

# Alternative calibration constructions (regenerated by --stage calibrate)
conformal_calibration_v2_sample_level.json
conformal_calibration_v2_cdf_pooling.json

# Ablation outputs (regenerated by --stage ablations)
ood_results.json
path2_tau_schedule_results.json

# Everything else is tracked on purpose, including:
#   capture_lib_v2/tumbling_target_dataset_v2.npz   (benchmark set)
#   capture_lib_v2/calibration_matched_200.npz      (deployed calibration set)
#   models/upn_target_v3.pt                          (trained predictor)
#   conformal_calibration_v2_repeated_subsample.json (deployed constants)
#   conformal_calibration_v2_traj_max.json           (values cited in the paper)
#   calibration_comparison.json                      (Figure 2 coverage panel)
#   path2_winning_v2_results.json, path2_conformal_v3_results.json
#   paper_figures/                                   (published figures and tables)

capture_lib_v2/_audit_*.npz
